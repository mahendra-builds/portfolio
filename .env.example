# ─────────────────────────────────────────────────────────────
# Contact form — server-side delivery only.
# The browser posts to /api/contact; the server route holds the
# credentials and forwards to the provider. No key is ever sent
# to the client, so there must be NO NEXT_PUBLIC_ prefixed key.
# ─────────────────────────────────────────────────────────────

# Inbox that receives contact form submissions
RECIPIENT_EMAIL=ma02raj@gmail.com

# ─────────────────────────────────────────────────────────────
# Resend — PRIMARY provider. Server-side delivery, works on the
# free tier (100 emails/day). Required for the contact form to
# actually send.
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender/domain on your Resend account
CONTACT_FROM="Mahendra Portfolio <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# Web3Forms — SECONDARY provider, used only if Resend is not
# configured or fails. Server-side usage requires a paid plan
# plus server IP whitelisting, so on the free tier this usually
# fails and the form falls back to the mailto link.
# https://web3forms.com
# ─────────────────────────────────────────────────────────────
WEB3FORMS_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# Sentry (optional — https://sentry.io, free tier available)
# Leave blank to disable error monitoring entirely.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────
# Vercel (set these in the Vercel dashboard, NOT in .env.local)
# ─────────────────────────────────────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Public site URL — used for Open Graph / Twitter card tags
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mahiweb.in
