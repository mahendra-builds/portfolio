# ─────────────────────────────────────────────────────────────
# Contact form — server-side delivery only.
# The browser posts to /api/contact; the server route holds the
# credentials and forwards to Resend. No key is ever sent to the
# client, so there must be NO NEXT_PUBLIC_ prefixed key.
#
# Resend is the ONLY delivery provider. Web3Forms was removed
# because its API rejects server-side calls on the free tier
# ("403 — This method is not allowed"), so it could never deliver.
#
# WARNING: without all three variables below the form answers 503
# ("email_not_configured") to every visitor — it never fails
# silently, but it also never delivered anything.
# Check what a deployment actually has:
#   curl https://mahiweb.in/api/contact
#   -> { "provider": "resend", "deliveryReady": true }
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Resend — the delivery provider. Server-side, works on the free
# tier (100 emails/day). REQUIRED.
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# Sender — the "from" address. REQUIRED.
#
# Resend rejects any sender whose domain is not verified on the
# account, so verify the domain first (Resend dashboard -> Domains
# -> add mahiweb.in and add the DNS records it gives you).
# Once the domain is verified you may use ANY address on it.
#
#   "Mahendra Rajput <hello@mahiweb.in>"
#
# NOTE: "onboarding@resend.dev" is only allowed to deliver to the
# account owner's own inbox, so it works only if your Resend
# account email is the same as RECIPIENT_EMAIL. Verify the domain
# instead — it is the only option that keeps working if the
# inbox address changes.
# ─────────────────────────────────────────────────────────────
CONTACT_FROM="Mahendra Rajput <hello@mahiweb.in>"

# ─────────────────────────────────────────────────────────────
# Recipient — the inbox that receives contact form submissions.
# REQUIRED. Defaults to the address below if the variable is unset.
# ─────────────────────────────────────────────────────────────
RECIPIENT_EMAIL=ma02raj@gmail.com

# ─────────────────────────────────────────────────────────────
# Production checklist (Vercel dashboard -> Project -> Settings
# -> Environment Variables -> Production, then redeploy):
#   RESEND_API_KEY        (required)
#   CONTACT_FROM          (required - verified sender)
#   RECIPIENT_EMAIL       (required - receiving inbox)
# The deploy workflow fails if any of them is missing for
# Production, and re-checks the live endpoint afterwards, so a
# broken contact form can never ship again.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Resend webhook (optional) — delivery status for contact form
# mail. Resend dashboard -> Webhooks -> add
#   https://mahiweb.in/api/webhooks/resend
# and subscribe to email.sent / email.delivered / email.bounced /
# email.complained, then paste the signing secret below.
# Events are verified with the Svix HMAC signature and logged.
# Check what a deployment has:  curl https://mahiweb.in/api/webhooks/resend
# Recent events are only returned when the request also sends
#   Authorization: Bearer <RESEND_WEBHOOK_SECRET>
# ─────────────────────────────────────────────────────────────
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Sentry (optional — https://sentry.io, free tier available)
# Leave blank to disable error monitoring entirely.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────
# Vercel (set these in the Vercel dashboard, NOT in .env.local)
# ─────────────────────────────────────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Public site URL — used for Open Graph / Twitter card tags
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mahiweb.in
