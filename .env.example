# ─────────────────────────────────────────────────────────────
# Contact form — server-side delivery only.
# The browser posts to /api/contact; the server route holds the
# credentials and forwards to the provider. No key is ever sent
# to the client, so there must be NO NEXT_PUBLIC_ prefixed key.
#
# WARNING: without a working provider key the form answers 503
# ("email_not_configured") to every visitor — it never fails
# silently, but it also never delivered anything.
# Check what a deployment actually has:
#   curl https://mahiweb.in/api/contact
#   -> { "providers": { "resend": true, "web3forms": false } }
# ─────────────────────────────────────────────────────────────

# Inbox that receives contact form submissions
RECIPIENT_EMAIL=ma02raj@gmail.com

# ─────────────────────────────────────────────────────────────
# Resend — PRIMARY provider. Server-side delivery, works on the
# free tier (100 emails/day). REQUIRED for the contact form to
# actually send.
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender/domain on your Resend account.
# NOTE: onboarding@resend.dev may only deliver to the account
# owner's own inbox — verify your domain and use it instead,
# e.g. "Mahendra Rajput <hello@mahiweb.in>".
CONTACT_FROM="Mahendra Portfolio <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# Web3Forms — SECONDARY provider, used only if Resend is not
# configured or fails. Server-side usage requires a paid plan
# plus server IP whitelisting, so on the free tier this usually
# fails and the form falls back to the mailto link.
# https://web3forms.com
# ─────────────────────────────────────────────────────────────
WEB3FORMS_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# Production checklist (Vercel dashboard -> Project -> Settings
# -> Environment Variables -> Production, then redeploy):
#   RESEND_API_KEY        (required)
#   RECIPIENT_EMAIL       (optional - defaults to the address above)
#   CONTACT_FROM          (recommended - verified sender)
#   WEB3FORMS_ACCESS_KEY  (optional - best-effort fallback)
# The deploy workflow fails if RESEND_API_KEY is missing for
# Production, so a broken contact form can never ship again.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Resend webhook (optional) — delivery status for contact form
# mail. Resend dashboard -> Webhooks -> add
#   https://mahiweb.in/api/webhooks/resend
# and subscribe to email.sent / email.delivered / email.bounced /
# email.complained, then paste the signing secret below.
# Events are verified with the Svix HMAC signature and logged.
# Check what a deployment has:  curl https://mahiweb.in/api/webhooks/resend
# ─────────────────────────────────────────────────────────────
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Sentry (optional — https://sentry.io, free tier available)
# Leave blank to disable error monitoring entirely.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────
# Vercel (set these in the Vercel dashboard, NOT in .env.local)
# ─────────────────────────────────────────────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Public site URL — used for Open Graph / Twitter card tags
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mahiweb.in
